{
  "tracker": { "url": {{tracker_url}}, "token_env": "KBL_INGEST_TOKEN" },
  "github": { "token_env": {{token_env}}, "own_logins": [] },
  "poll_seconds": 60,
  "rules": [
    {
      "name": {{label}},
      "repo": {{repo}},
      "mode": {{mode}},
      "labels_all": [{{label}}],
      "default_tier": 2,
      "cap": {{cap}}
    }
  ]
}
