{
  "tracker": { "url": {{tracker_url}}, "token_env": "KBL_INGEST_TOKEN" },
  "jira": {
    "site": {{site}},
    "api": {{api}},
    "email": {{email}},
    "token_env": {{token_env}},
    "own_logins": []
  },
  "poll_seconds": 60,
  "rules": [
    {
      "name": {{label}},
      "repo": {{repo}},
      "jql": {{jql}},
      "mode": {{mode}},
      "triage": {{triage}},
      "target_repo": {{target_repo}},
      "default_tier": 2,
      "cap": {{cap}}
    }
  ]
}
