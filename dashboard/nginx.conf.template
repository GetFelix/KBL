server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  # The image's entrypoint fills in the container's own DNS server from
  # /etc/resolv.conf (Docker's 127.0.0.11, Podman's aardvark-dns), so the
  # tracker's name is looked up again after it restarts with a new address.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=5s;

  location /v1/ {
    set $tracker http://tracker:8790;
    proxy_pass $tracker;
    # The tracker answers a work_next that waits, so give it room.
    proxy_read_timeout 60s;
  }
}
